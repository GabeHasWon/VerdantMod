GraveDialogue: {
	Listen: Ouça

	Ma: {
		Name: Ma
		0: Eu ainda...
		1: Orgulho...de você...
		2: (Risada)
	}

	Pa: {
		Name: Pa
		0: Volte quando...
		1: ...você é o...melhor...
		2: ...é...impressionante...
	}

	Dreams: {
		Name: ...
		0: Uma terra...distante...
		1: Inexplorada, mas...
		2: A rocha...apontada...
	}

	Me: {
		Name: Eu
		0: Trabalhou duro, mas... Eu não...
		1: Será que... Valeu a pena...?
		2: ...mas eu não consigo vê-los de novo.
		3: Acho que estou orgulhoso do que...fiz...
		4: ...talvez sempre tão longe...
		5: Sinto falta...do som do lápis no papel...
		6: Tolo, levado pelo...ego...
		7: Talvez o melhor...de todos os tempos...
		8: Mas ainda, sou apenas, eu.
	}
}

GenConfigs: {
	Pages: {
		Verdant: {
			Name: Verdejante
			Description: Controla os aspectos da geração do Verdejante.

			Members: {
				WaterMultiplier: {
					DisplayName: "[i:126] Multiplicador de Água"
					Tooltip: Multiplicador da quantidade de água colocada no Verdejante.
				}

				CircleModifier: {
					DisplayName: "[i:2] Mult. de Tamanho Base"
					Tooltip: Modifica quão grande o "tamanho base" das formas de geração do bioma são.
				}

				StoneModifier: {
					DisplayName: "[i:3] Multiplicador de Pedra"
					Tooltip: Multiplicador da quantidade de pedra colocada no Verdejante.
				}

				OreModifier: {
					DisplayName: "[i:13] Multiplicador de Minérios"
					Tooltip: Multiplicador da quantidade de minérios colocados no Verdejante.
				}

				AquamarineModifier: {
					DisplayName: "[i:Verdant/EmbeddedAquamarineItem] Mult. de Água-Marinha"
					Tooltip: Multiplicador da quantidade de Blocos de Solo Exuberante de Água-Marinha colocados no Verdejante.
				}

				WaterfallModifier: {
					DisplayName: "[i:206] Multiplicador de Cachoeiras"
					Tooltip: Multiplicador da quantidade de cachoeiras colocadas no Verdejante.
				}

				VinesModifier: {
					DisplayName: "[i:Verdant/VineRopeItem] Multiplicador de Vinhas"
					Tooltip: Multiplicador da quantidade de vinhas arqueadas sólidas colocadas no Verdejante.
				}

				VinesChance: {
					DisplayName: "[i:Verdant/VineRopeItem] Chance de Vinhas"
					Tooltip: Indiretamente, a chance de vinhas cortáveis surgirem em superfícies válidas. 0 vai colocar nenhuma vinha.
				}

				VineStrongChance: {
					DisplayName: "[i:Verdant/VerdantStrongVineMaterial] Chance de Vinhas Resist."
					Tooltip: A chance de vinhas cortáveis surgirem como vinhas resistentes.
				}

				LightbulbChance: {
					DisplayName: "[i:Verdant/Lightbulb] Chance de Flor Bulbo Lum."
					Tooltip: A chance de uma Flor de Bulbo Luminoso surgir em chão válido.
				}

				WaterfallFlowerChance: {
					DisplayName: "[i:Verdant/WaterPlantItem] Chance de Gomo Chorão" //choradeiro was too big...
					Tooltip: A chance de Gomos Choradeiros surgirem em tetos válidos.
				}

				BeehiveChance: {
					DisplayName: "[i:Verdant/BeehiveBlock] Chance de Colmeia"
					Tooltip: A chance de uma colmeia surgir em chão válido.
				}

				WallLightbulbChance: {
					DisplayName: "[i:Verdant/VerdantFlowerBulb] Chance de Flor de Parede"
					Tooltip: A chance de uma flor de parede surgir em paredes válidas.
				}

				WallLightbulbBigChance: {
					DisplayName: "[i:Verdant/VerdantFlowerBulb] Chance de Flor de Parede G" //a little too big...
					Tooltip: A chance de uma flor de parede grande surgir em paredes válidas.
				}

				TreeChance: {
					DisplayName: "[i:Verdant/VerdantWoodBlock] Chance de Árvore"
					Tooltip: A chance de uma árvore surgir em espaços válidos.
				}

				PuffChance: {
					DisplayName: "[i:Verdant/PinkPuff] Chance de Bola Felpuda"
					Tooltip: A chance de uma bola felpuda rosa surgir em chão válido.
				}
			}
		}

		Backslate: {
			Name: Bardósia
			Description: Controla a geração dos microbiomas de 'bardósia' do Verdejante.

			Members: {
				BackslateMicrobiomeModifier: {
					DisplayName: "[i:Verdant/BackslateWallItem] Modificador de Quantidade"
					Tooltip: Aumenta ou diminui a quantidade de pontos de Bardósia criados no Verdejante.
				}

				BackslateSizeModifier: {
					DisplayName: "[i:Verdant/BackslateWallItem] Modificador de Tamanho"
					Tooltip: Modificador do tamanho dos aglomerados de Bardósia criados.
				}

				BackslateSpam: {
					DisplayName: "[i:Verdant/BackslateTileItem] Quantia de Blocos"
					Tooltip: Modificador do número de aglomerados criados por microbioma.
				}

				BackslateWidth: {
					DisplayName: "[i:Verdant/BackslateTileItem] Largura do Bioma"
					Tooltip: A largura total do microbioma em blocos.
				}

				AquamarineChance: {
					DisplayName: "[i:Verdant/AquamarineItem] Chance de Água-Marinha"
					Tooltip: A chance de águas-marinhas soltas surgirem em massa ao redor do local.
				}

				WallChance: {
					DisplayName: "[i:Verdant/BackslateWallItem] Chance de Parede"
					Tooltip: A chance de uma parede de pilar de bardósia ser colocada.
				}

				BubblingWallChance: {
					DisplayName: "[i:Verdant/BackslateBubblingWallItem] Chance de Parede Perfurada"
					Tooltip: A chance de uma parede individual de bardósia se tornar uma parede de bardósia perfurada no lugar.
				}

				BushChance: {
					DisplayName: "[i:Verdant/WaterberryBushItem] Chance de Arbusto"
					Tooltip: A chance de um arbusto de baga aquosa surgir em chão válido.
				}

				RandomAquamarine: {
					DisplayName: "[i:Verdant/EmbeddedStoneAquamarineItem] Quant. de Água-Marinha"
					Tooltip: A quantidade de veios de água-marinha embutidas em pedra fora do Verdejante.
				}

				AquamarineChunkSize: {
					DisplayName: "[i:Verdant/EmbeddedStoneAquamarineItem] Tamanho da Água-Marinha"
					Tooltip: O tamanho dos veios de água-marinha embutidas em pedra fora do Verdejante.
				}
			}
		}
	}
}
