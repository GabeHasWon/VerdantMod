HeadLabel: Configuración de cliente de Verdant
EnableSteamEffectLabel: "[i:3365] Activar efecto de vapor"
EnableSteamEffectTooltip: Activa el recubrimiento de vapor al estar en las cuevas verdeantes
EnableForeOrBackgroundObjectsLabel: "[i:933] Activar objetos de fondo y primer plano"
EnableForeOrBackgroundObjectsTooltip: Activa objetos de decoración en el fondo de la superficie o por todas partes del primer plano.
EnableCustomWaterfallsLabel: "[i:2169] Activar cascadas personalizadas"
EnableCustomWaterfallsTooltip: Permite que aparezcan cascadas desde ciertos bloques, como el brote llorón.
CustomDialogueSystemLabel: "[i:320] Sistema de diálogos personalizado"
CustomDialogueSystemTooltip: Permite el uso de un sistema de dialogo personalizado para el Apoteosis. Si se desactiva, utilizará el chat.
FancyBookUILabel: "[i:4065] UI de libro elegante"
FancyBookUITooltip: Cambia la UI de libro a algo único

VerdantClientConfig: {
	DisplayName: "{$Mods.Verdant.Configs.HeadLabel}"

	EnableSteam: {
		Label: "{$Mods.Verdant.Configs.EnableSteamEffectLabel}"
		Tooltip: "{$Mods.Verdant.Configs.EnableSteamEffectTooltip}"
	}

	BackgroundObjects: {
		Label: "{$Mods.Verdant.Configs.EnableForeOrBackgroundObjectsLabel}"
		Tooltip: "{$Mods.Verdant.Configs.EnableForeOrBackgroundObjectsTooltip}"
	}

	Waterfalls: {
		Label: "{$Mods.Verdant.Configs.EnableCustomWaterfallsLabel}"
		Tooltip: "{$Mods.Verdant.Configs.EnableCustomWaterfallsTooltip}"
	}

	CustomDialogue: {
		Label: "{$Mods.Verdant.Configs.CustomDialogueSystemLabel}"
		Tooltip: "{$Mods.Verdant.Configs.CustomDialogueSystemTooltip}"
	}

	JungleSpawn: {
		Label: "[i:620] Generación en la Jungla"
		Tooltip: Obliga al verdor a generarse en la jungla y reduce la probabilidad de sobrescribir biomas modeados. No funciona si la generación central esta activada.
	}

	DialogueSpeed: {
		Label: "[i:4485] Velocidad del diálogo"
		Tooltip: Incrementa o disminuye la velocidad del diálogo para todo el texto en pantalla.
	}

	CenterSpawn: {
		Label: "[i:9] Generación central"
		Tooltip: El verdor se generará debajo de la generación inicial del jugador. Esto puede causar superposición con biomas como el Desierto y la Nieve, y reemplaza la configuración de generación en la Jungla.
	}
}
