GameTips: {
	VerdantGameTip0: Habla con el Apoteosis a menudo, podría tener recompensas para ti.
	VerdantGameTip1: ¡Las frondosas cuevas verdeantes ofrecen un respiro en cualquier lugar!
}

DryadShop: {
	Restock: Reabastece una vez cada 5 días, o una vez cada 3 días si está en el Verdor
	Condition: Cada otra rotación de existencias
}

ShowApoth: Enséñale esto al Apoteosis al darle clic derecho
HardmodeMessage: La lozanía del verdor retumba con vitalidad...

GraveDialogue: {
	Listen: Escucha

	Ma: {
        Name: Ma
        0: Todavía estoy...
        1: Orgullosa...de ti...
        2: (Risa)
    }

    Pa: {
        Name: Pa
        0: Regresa cuando...
        1: ...seas el...mejor...
        2: ...es...impresionante...
    }

    Dreams: {
        Name: ...
        0: Una tierra...lejana...
        1: Inexplorada, pero...
        2: La roca...apuntaba...
    }

    Me: {
        Name: Yo
        0: Trabajé mucho, pero...no creo...
        1: ¿Valió...la pena todo...?
        2: ...pero no puedo verlos de nuevo.
        3: Creo que estoy orgullosa de...haberlo hecho...
        4: ...quizás siempre estuvo demasiado lejos...
        5: Extraño...el sonido del lápiz sobre el papel...
        6: Necia, guiada por...el ego...
        7: Quizás la mejor...de todos los tiempos...
        8: Pero aún así, solo, yo.
    }
}

GenConfigs: {
	Pages: {
		Verdant: {
			Name: Verdant
			Description: Controla aspectos de la generación del verdor.

			Members: {
				WaterMultiplier: {
					DisplayName: "[i:126] Multiplicador del agua"
					Tooltip: Multiplica la cantidad de agua generada en el verdor.
				}

				CircleModifier: {
					DisplayName: "[i:2] Multiplicador del tamaño base"
					Tooltip: Modifica que tan grande es el "tamaño base" de las formas usadas para la generación del bioma.
				}

				StoneModifier: {
					DisplayName: "[i:3] Multiplicador de piedra"
					Tooltip: Multiplica la cantidad de piedra generada en el verdor.
				}

				OreModifier: {
					DisplayName: "[i:13] Multiplicador de oro"
					Tooltip: Multiplica la cantidad de oro generado en el verdor.
				}

				AquamarineModifier: {
					DisplayName: "[i:Verdant/EmbeddedAquamarineItem] Multiplicador de aguamarina"
					Tooltip: Multiplica la cantidad de aguamarina generada en el verdor.
				}

				WaterfallModifier: {
					DisplayName: "[i:206] Multiplicador de cascadas"
					Tooltip: Multiplica la cantidad de cascadas generadas en el verdor.
				}

				VinesModifier: {
					DisplayName: "[i:Verdant/VineRopeItem] Multiplicador de vides"
					Tooltip: Multiplica la cantidad de vides solidas generadas en el verdor.
				}

				VinesChance: {
					DisplayName: "[i:Verdant/VineRopeItem] Probabilidad de enredadera"
					Tooltip: La probabilidad de que aparezcan enredaderas cortables sobre superficies válidas. Con valor 0 no aparecerán enredaderas.
				}

				VineStrongChance: {
					DisplayName: "[i:Verdant/VerdantStrongVineMaterial] Probabilidad de enredadera resistente"
					Tooltip: La probabilidad de que las enredaderas cortables aparezcan en su lugar como vides solidas.
				}

				LightbulbChance: {
					DisplayName: "[i:Verdant/Lightbulb] Probabilidad de flor bulbrillo"
					Tooltip: La probabilidad de que aparezcan flores bulbrillo sobre superficies válidas. 
				}

				WaterfallFlowerChance: {
					DisplayName: "[i:Verdant/WaterPlantItem] Probabilidad de pimpollo lagrimeante"
					Tooltip: La probabilidad de que aparezcan pimpollos lagrimeantes sobre tejados válidos. 
				}

				BeehiveChance: {
					DisplayName: "[i:Verdant/BeehiveBlock] Probabilidad de colmena de abejorro"
					Tooltip: La probabilidad de que aparezcan colmenas de abejorros sobre superficies válidas. 
				}

				WallLightbulbChance: {
					DisplayName: "[i:Verdant/VerdantFlowerBulb] Probabilidad de bulbo floral"
					Tooltip: La probabilidad de que aparezcan bulbos florales sobre paredes válidas.
				}

				WallLightbulbBigChance: {
					DisplayName: "[i:Verdant/VerdantFlowerBulb] Probabilidad de bulbo floral grande"
					Tooltip: La probabilidad de que aparezcan bulbos florales grandes sobre paredes válidas.
				}

				TreeChance: {
					DisplayName: "[i:Verdant/VerdantWoodBlock] Probabilidad de árbol frondoso"
					Tooltip: La probabilidad de que aparezcan arboles frondosos en espacios válidos.
				}

				PuffChance: {
					DisplayName: "[i:Verdant/PinkPuff] Probabilidad de resplandor esponjoso"
					Tooltip: La probabilidad de que aparezcan resplandores esponjosos sobre superficies válidas. 
				}
			}
		}

		Backslate: {
			Name: Pizarra
			Description: Controla la generación de los microbiomas de 'pizarra' del verdor.

			Members: {
				BackslateMicrobiomeModifier: {
					DisplayName: "[i:Verdant/BackslateWallItem] Modificador de cantidad"
					Tooltip: Incrementa o reduce la cantidad de puntos de generación de pizarra en el verdor. 
				}

				BackslateSizeModifier: {
					DisplayName: "[i:Verdant/BackslateWallItem] Modificador de tamaño"
					Tooltip: Modifica el tamaño de los grupos de pizarra generados.
				}

				BackslateSpam: {
					DisplayName: "[i:Verdant/BackslateTileItem] Conteo de bloques"
					Tooltip: Modifica el numero de grupos creados por microbioma.
				}

				BackslateWidth: {
					DisplayName: "[i:Verdant/BackslateTileItem] Ancho del bioma"
					Tooltip: La anchura general en bloques del microbioma.
				}

				AquamarineChance: {
					DisplayName: "[i:Verdant/AquamarineItem] Probabilidad de aguamarina"
					Tooltip: La probabilidad de que la aguamarina no incrustada aparezca alrededor del lugar en masa.
				}

				WallChance: {
					DisplayName: "[i:Verdant/BackslateWallItem] Probabilidad de pared"
					Tooltip: La probabilidad de colocar paredes de pizarra.
				}

				BubblingWallChance: {
					DisplayName: "[i:Verdant/BackslateBubblingWallItem] Probabilidad de pared perforada"
					Tooltip: La probabilidad individual de una pared de pizarra de ser una pared de pizarra perforada en su lugar.
				}

				BushChance: {
					DisplayName: "[i:Verdant/WaterberryBushItem] Probabilidad de arbusto"
					Tooltip: La probabilidad de que aparezcan arbustos de acuabaya sobre superficies válidas. 
				}

				RandomAquamarine: {
					DisplayName: "[i:Verdant/EmbeddedStoneAquamarineItem] Conteo de bloque de piedra de aguamarina"
					Tooltip: El numero de venas de aguamarina incrustada en piedra generadas independientes al verdor.
				}

				AquamarineChunkSize: {
					DisplayName: "[i:Verdant/EmbeddedStoneAquamarineItem] Tamaño de bloque de piedra de aguamarina"
					Tooltip: El tamaño de las venas de bloque de piedra de aguamarina independientes al verdor.
				}
			}
		}
	}
}
